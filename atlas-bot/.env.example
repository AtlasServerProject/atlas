DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# ID da conta do DONO e do canal privado de administração (configurados juntos).
DISCORD_OWNER_ID=
DISCORD_OWNER_CHANNEL_ID=
MINECRAFT_ADDRESS=
MODPACK_URL=
# Canal de texto para /aviso e eventos Minecraft (ID, não nome).
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
# Integração opcional: habilitada somente quando definida uma chave de 32+ caracteres.
ATLAS_BRIDGE_SECRET=
ATLAS_BRIDGE_PORT=8787

# Boas-vindas habilitadas por padrão. ID vazio detecta um único boas-vindas/bem-vindo.
DISCORD_WELCOME_ENABLED=true
DISCORD_WELCOME_CHANNEL_ID=

DISCORD_MEMBER_ROLE_ID=

# Consulta local do Minecraft, sem RCON.
MINECRAFT_STATUS_HOST=127.0.0.1
MINECRAFT_STATUS_PORT=25565

# Novidades do site: só configurar após publicar /updates.json no site público.
# Exemplo: https://atlascobblemon.com.br/updates.json
ATLAS_NEWS_FEED_URL=
# ID do canal escolhido; não cria canal automaticamente.
DISCORD_NEWS_CHANNEL_ID=
# Ativação explícita. Primeira sincronização registra o histórico sem enviar.
ATLAS_NEWS_AUTO=false
ATLAS_NEWS_INTERVAL_SECONDS=300
# Preserve este arquivo entre reinícios/deploys. Execute uma única instância.
ATLAS_NEWS_STATE_FILE=.runtime/news-state.json
