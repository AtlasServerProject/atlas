{
  "name": "atlas-launcher-workspace",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @atlas/desktop",
    "typecheck": "npm run typecheck -w @atlas/desktop",
    "test": "npm test -w @atlas/desktop",
    "start": "node scripts/start.mjs",
    "setup": "install-electron",
    "predev": "npm run setup",
    "prestart": "npm run setup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "configure:microsoft": "node scripts/configure-microsoft.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "prettier": "3.9.10"
  }
}
