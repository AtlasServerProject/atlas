#!/bin/bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

COMMAND="${1:-}"

if [ "$#" -gt 0 ]; then
    shift
fi

ADMIN_SOCKET="${ATLAS_ADMIN_SOCKET:-/opt/atlas/server/fabric/atlas-admin.sock}"

run_admin_command() {
    local command="$1"

    if [ ! -S "$ADMIN_SOCKET" ]; then
        echo "Console Atlas indisponível em $ADMIN_SOCKET."
        return 1
    fi

    # Python instead of nc: Ubuntu's nc.openbsd AppArmor profile denies connecting to this socket.
    python3 -I -c '
import socket, sys
with socket.socket(socket.AF_UNIX) as s:
    s.settimeout(30)
    s.connect(sys.argv[1])
    s.sendall((sys.argv[2] + "\n").encode())
    s.shutdown(socket.SHUT_WR)
    sys.stdout.write(s.makefile(encoding="utf-8", errors="replace").read())
' "$ADMIN_SOCKET" "$command"
}

case "$COMMAND" in

    install)
        "$SCRIPT_DIR/install.sh"
        ;;

    doctor)
        "$SCRIPT_DIR/doctor.sh"
        ;;

    backup)
        "$SCRIPT_DIR/backup.sh" "$@"
        ;;

    restore)
        "$SCRIPT_DIR/restore.sh" "$@"
        ;;

    update)
        "$SCRIPT_DIR/update.sh"
        ;;
    migrate)
        "$SCRIPT_DIR/migrate.sh"
        ;;

    backup-verify)
        exec python3 "$SCRIPT_DIR/backup-manager.py" verify "$@"
        ;;

    start)
        sudo systemctl start atlas
        ;;

    stop)
        sudo systemctl stop atlas
        ;;

    restart)
        sudo systemctl restart atlas
        ;;

    status)
        sudo systemctl status atlas
        ;;

    logs)
        journalctl -u atlas -f
        ;;

    console)
        if [ ! -S "$ADMIN_SOCKET" ]; then
            echo "Console Atlas indisponível em $ADMIN_SOCKET."
            exit 1
        fi

        echo "Console administrativo Atlas. Use 'exit' para sair."
        while IFS= read -r -p "atlas> " admin_command; do
            case "$admin_command" in
                exit|quit)
                    break
                    ;;
                "")
                    continue
                    ;;
                *)
                    run_admin_command "$admin_command"
                    ;;
            esac
        done
        ;;

    exec)
        if [ "$#" -eq 0 ]; then
            echo "Uso: atlas-cli exec <comando>"
            exit 1
        fi

        run_admin_command "$*"
        ;;

    pregenerate-survival)
        action="${1:-status}"
        case "$action" in
            start)
                run_admin_command "chunky world atlas:survival_emerald"
                run_admin_command "chunky shape square"
                run_admin_command "chunky center 0 0"
                run_admin_command "chunky radius 6000"
                run_admin_command "chunky quiet 60"
                run_admin_command "chunky start"
                ;;
            status)
                run_admin_command "chunky progress"
                ;;
            pause)
                run_admin_command "chunky pause"
                ;;
            continue|resume)
                run_admin_command "chunky continue"
                ;;
            *)
                echo "Uso: atlas-cli pregenerate-survival [status|start|pause|continue|resume]"
                exit 1
                ;;
        esac
        ;;

    pregenerate-nether)
        action="${1:-status}"
        case "$action" in
            start)
                run_admin_command "chunky world minecraft:the_nether"
                run_admin_command "chunky shape square"
                run_admin_command "chunky center 0 0"
                run_admin_command "chunky radius 6000"
                run_admin_command "chunky quiet 60"
                run_admin_command "chunky start"
                ;;
            status)
                run_admin_command "chunky progress"
                ;;
            pause)
                run_admin_command "chunky pause"
                ;;
            continue|resume)
                run_admin_command "chunky continue"
                ;;
            *)
                echo "Uso: atlas-cli pregenerate-nether [status|start|pause|continue|resume]"
                exit 1
                ;;
        esac
        ;;

    pregenerate-end)
        action="${1:-status}"
        case "$action" in
            start)
                run_admin_command "chunky world minecraft:the_end"
                run_admin_command "chunky shape square"
                run_admin_command "chunky center 0 0"
                run_admin_command "chunky radius 6000"
                run_admin_command "chunky quiet 60"
                run_admin_command "chunky start"
                ;;
            status)
                run_admin_command "chunky progress"
                ;;
            pause)
                run_admin_command "chunky pause"
                ;;
            continue|resume)
                run_admin_command "chunky continue"
                ;;
            *)
                echo "Uso: atlas-cli pregenerate-end [status|start|pause|continue|resume]"
                exit 1
                ;;
        esac
        ;;

    *)
        echo "Atlas CLI"
        echo
        echo "Uso:"
        echo "  atlas-cli install"
        echo "  atlas-cli doctor"
        echo "  atlas-cli backup"
        echo "  atlas-cli backup-verify <backup>"
        echo "  atlas-cli restore <backup> --confirm [--target <pasta> --database <banco>]"
        echo "  atlas-cli start"
        echo "  atlas-cli stop"
        echo "  atlas-cli restart"
        echo "  atlas-cli status"
        echo "  atlas-cli logs"
        echo "  atlas-cli console"
        echo "  atlas-cli exec <comando>"
        echo "  atlas-cli pregenerate-survival [start|status|pause|continue]"
        echo "  atlas-cli pregenerate-nether [start|status|pause|continue]"
        echo "  atlas-cli pregenerate-end [start|status|pause|continue]"
        echo "  atlas-cli migrate"
        ;;
esac
