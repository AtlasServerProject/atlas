[Unit]
Description=Atlas encrypted off-site copy of the newest backup (restic)
After=network-online.target atlas-backup.service
Wants=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/atlas/scripts/offsite-backup.py --config /etc/atlas/offsite.json upload
CacheDirectory=atlas-offsite
TimeoutStartSec=6h
Restart=on-failure
RestartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
