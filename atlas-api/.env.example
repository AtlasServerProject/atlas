# Documentation only: scripts/init-local-env.py generates random local secrets into ignored .env.
# Never use the Minecraft database or copy production credentials here.
SPRING_PROFILES_ACTIVE=local
ATLAS_DB_URL=jdbc:postgresql://127.0.0.1:55432/atlas_api_local
ATLAS_DB_USERNAME=atlas_api_runtime
ATLAS_MIGRATION_USERNAME=atlas_api_migrator
ATLAS_DB_PASSWORD=
ATLAS_MIGRATION_PASSWORD=
ATLAS_BOOTSTRAP_PASSWORD=
ATLAS_BIND_ADDRESS=127.0.0.1
ATLAS_PORT=8080

# Mail is local in the local/test profiles. Configure SMTP externally for staging/prod.
ATLAS_MAIL_ENCRYPTION_KEY=
ATLAS_WEB_URL=http://localhost:4200
ATLAS_MAIL_FROM=
ATLAS_SMTP_HOST=
ATLAS_SMTP_PORT=587
ATLAS_SMTP_USERNAME=
ATLAS_SMTP_PASSWORD=
