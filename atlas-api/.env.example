# Documentation only: scripts/init-local-env.py generates random local secrets into ignored .env.
# Never use the Minecraft database or copy production credentials here.
SPRING_PROFILES_ACTIVE=local
ATLAS_DB_URL=jdbc:postgresql://127.0.0.1:55432/atlas_api_local
ATLAS_DB_USERNAME=atlas_api_runtime
ATLAS_MIGRATION_USERNAME=atlas_api_migrator
ATLAS_DB_PASSWORD=
ATLAS_MIGRATION_PASSWORD=
ATLAS_BOOTSTRAP_PASSWORD=
ATLAS_BIND_ADDRESS=127.0.0.1
ATLAS_PORT=8080

# Mail is local in the local/test profiles. Configure SMTP externally for staging/prod.
ATLAS_MAIL_ENCRYPTION_KEY=
ATLAS_WEB_URL=http://localhost:4200
ATLAS_MAIL_FROM=
ATLAS_SMTP_HOST=
ATLAS_SMTP_PORT=587
ATLAS_SMTP_USERNAME=
ATLAS_SMTP_PASSWORD=

# M4: generate a private 256-bit shared key for the same-VM Core bridge.
# Leave empty to disable Core proof acceptance; do not expose it to the frontend.
ATLAS_CORE_KEY=
# Remains false until payments and delivery are homologated.
ATLAS_SALES_ENABLED=false

# M5: private Mercado Pago credentials; disabled until external homologation.
# Test seller and production seller must use separate credentials/environments.
ATLAS_PAYMENT_ENABLED=false
ATLAS_MP_MODE=test
ATLAS_MP_ACCESS_TOKEN=
ATLAS_MP_WEBHOOK_SECRET=
ATLAS_MP_COLLECTOR_ID=
# Public HTTPS endpoint; use the stable Netlify proxy, not the rotating tunnel.
ATLAS_MP_NOTIFICATION_URL=https://atlas-cobblemon.netlify.app/api/v1/webhooks/mercadopago
